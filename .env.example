# قيم مشروع Supabase — من Project Settings → API.
# anon key ده مفتاح عام بالتصميم (محمي بـRLS، راجع supabase/schema.sql) — آمن إنه يظهر في كود المتصفح.
# ما تحطش service_role هنا أبدًا — الموقع مستضاف Static على GitHub Pages، مفيش سيرفر يخبّي مفتاح سري.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# بيانات العيادة (الاسم، الدكتور، التليفون، الواتساب، الخريطة) مكتوبة مباشرة في src/lib/clinicInfo.ts
# ومش من env — المحتوى ده ثابت وخاص بالعيادة دي بالظبط.
